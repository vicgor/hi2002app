/* ============================================================
   HI2002 App — Light Theme
   Palette: background #f8f9fa, surface #ffffff, accent #0277bd
   ============================================================ */

QWidget {
    background-color: #f8f9fa;
    color: #212121;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f8f9fa;
}

/* ---- Toolbar ---- */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #dee2e6;
    spacing: 4px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #212121;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 10px;
    min-width: 64px;
}

QToolBar QToolButton:hover {
    background-color: #e3f2fd;
    border-color: #0277bd;
}

QToolBar QToolButton:pressed {
    background-color: #0277bd;
    color: #ffffff;
}

QToolBar QToolButton:disabled {
    color: #9e9e9e;
}

QToolBar::separator {
    width: 1px;
    background-color: #dee2e6;
    margin: 4px 6px;
}

/* ---- Tab Widget ---- */
QTabWidget::pane {
    border: 1px solid #dee2e6;
    background-color: #ffffff;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #f1f3f5;
    color: #495057;
    border: 1px solid #dee2e6;
    border-bottom: none;
    padding: 6px 18px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 120px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0277bd;
    border-bottom: 2px solid #0277bd;
}

QTabBar::tab:hover:!selected {
    background-color: #e9ecef;
    color: #212121;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #e9ecef;
    color: #495057;
    border-top: 1px solid #dee2e6;
    font-size: 12px;
}

QStatusBar QLabel {
    color: #495057;
    padding: 0 6px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #ced4da;
    border-radius: 5px;
    padding: 5px 16px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #e3f2fd;
    border-color: #0277bd;
}

QPushButton:pressed {
    background-color: #0277bd;
    color: #ffffff;
}

QPushButton:default {
    border: 2px solid #0277bd;
}

QPushButton:disabled {
    background-color: #f8f9fa;
    color: #9e9e9e;
    border-color: #dee2e6;
}

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #0277bd;
    selection-color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #0277bd;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #212121;
    selection-background-color: #e3f2fd;
    border: 1px solid #ced4da;
    outline: none;
}

/* ---- GroupBox ---- */
QGroupBox {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    color: #495057;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #0277bd;
}

/* ---- Labels ---- */
QLabel {
    color: #212121;
    background: transparent;
}

QLabel#ph_display {
    font-size: 56px;
    font-weight: bold;
    color: #0277bd;
    letter-spacing: 2px;
}

QLabel#equilibrium_label {
    font-size: 14px;
    font-weight: bold;
    color: #2e7d32;
    padding: 4px 10px;
    border: 1px solid #2e7d32;
    border-radius: 4px;
}

/* ---- Dialogs ---- */
QDialog {
    background-color: #f8f9fa;
}

QMessageBox {
    background-color: #f8f9fa;
    color: #212121;
}

QMessageBox QPushButton {
    min-width: 72px;
}

/* ---- ScrollBars ---- */
QScrollBar:vertical {
    background-color: #f1f3f5;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #ced4da;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0277bd;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #f1f3f5;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #ced4da;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0277bd;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #dee2e6;
    width: 2px;
    height: 2px;
}
